<mxfile host="app.diagrams.net">
  <diagram name="RAG Retrieval and Synthesis" id="ragretrieval">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="e0" value="answer(question, k_prose, doc_ids)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="340" height="45" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="router.route() -&gt; lane&#10;(prose / tables / both; default both)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="90" width="340" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="prose_search.search()&#10;HNSW cosine -&gt; websearch_to_tsquery -&gt; OR-of-terms -&gt; ILIKE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="320" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="table_search.search(k=4)&#10;digest HNSW -&gt; OR-of-terms FTS&#10;+ page-expansion union from prose hits' pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="620" y="180" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="prompt_budget.assemble_evidence()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="270" width="340" height="45" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="limit = max_model_len() - OUTPUT_RESERVE(2000) - SAFETY_MARGIN(256)&#10;count_tokens via vLLM /tokenize (fallback: pessimistic char/token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="290" y="330" width="420" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="Tables first (budget = avail - PROSE_FLOOR)&#10;expand_table_for_prompt (rectangularize rowspan/colspan)&#10;fits whole -&gt; include, else DROP WHOLE (never truncate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="360" height="65" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="Prose fills remainder&#10;strip_tables() first, then clip mid-string if needed&#10;(prose has no structure to corrupt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="580" y="410" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="Recount joined evidence string (tokenizers not additive)&#10;still over limit? shed whole tables, largest/last-added first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="290" y="495" width="420" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e9" value="report: included[], dropped[], malformed[], prose_clipped, limit, input_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="570" width="420" height="45" as="geometry" />
        </mxCell>

        <mxCell id="e10" value="aggregate_guard.classify(question, report)&#10;regex match: average/sum/count/min/max/... ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="330" y="640" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e11" value="not_aggregate&#10;no prompt_note, no warnings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="750" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e12" value="answerable&#10;1 table, rows &lt;= TRUSTWORTHY_ROWS(25)&#10;-&gt; note: may compute over these rows, show values used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="240" y="750" width="240" height="65" as="geometry" />
        </mxCell>

        <mxCell id="e13" value="partial&#10;report shows dropped/malformed/clipped&#10;-&gt; note: evidence incomplete, do NOT compute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="500" y="750" width="240" height="65" as="geometry" />
        </mxCell>

        <mxCell id="e14" value="unsupported&#10;no table at all, or too many rows/tables&#10;-&gt; refuse; point to /rag/corpus-tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="750" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="e15" value="evidence += agg.prompt_note&#10;warnings = quality_warnings(report) + agg.warnings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="850" width="340" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e16" value="llm_client.complete(evidence, system, max_tokens=OUTPUT_RESERVE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="310" y="930" width="380" height="45" as="geometry" />
        </mxCell>

        <mxCell id="e17" value="RAG_LLM_URL set?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="1000" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e18" value="vLLM (Qwen3-32B-AWQ), temperature=0&#10;HTTP 4xx -&gt; raise ContextOverflow (never falls back)&#10;5xx / conn error -&gt; may fall back if allow_fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="1090" width="360" height="65" as="geometry" />
        </mxCell>

        <mxCell id="e19" value="Local fallback: Qwen2.5-VL&#10;(run_plain_text_inference, resident in OCR process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="1090" width="360" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e20" value="_LAST_BACKEND (thread-local) records what actually ran&#10;last_backend() preferred over inferential backend_name()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="290" y="1180" width="420" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e21" value="synthesize.answer() response:&#10;answer text, lane, citations (prose + included tables),&#10;tables_used/dropped, input_tokens, warnings, backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="1270" width="420" height="65" as="geometry" />
        </mxCell>

