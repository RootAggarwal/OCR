<mxfile host="app.diagrams.net">
  <diagram name="OCR Structured Page Path" id="ocrpage">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a1" value="Page image rendered&#10;RENDER_LONGEST_DIM = 2200px (structured) / 1288px (legacy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="360" height="50" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="_process_page_structured(img, worker_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="300" height="45" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="table_extractor.extract_page_html(img)&#10;TATR detect_tables -&gt; merge -&gt; pad -&gt; plausibility guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="175" width="360" height="55" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="import failed?&#10;(_te unbound)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="175" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="Print warning, tables=[] boxes=[] structured=[]&#10;falls through to no-table branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="Any tables detected?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="255" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a7" value="NO-TABLE BRANCH&#10;Whole page read: _run_enhanced_ocr with format-preserving prompt&#10;(same as legacy path for this page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a8" value="harvest_inline_tables(text)&#10;pulls any &lt;table&gt; the VLM emitted natively&#10;tagged source=&quot;prose_html&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="320" height="55" as="geometry" />
        </mxCell>

        <mxCell id="a9" value="TABLE-PRESENT BRANCH&#10;_mask_table_regions(img, boxes) -&gt; white-out boxes&#10;_downscale_for_prose -&gt; PROSE_RENDER_DIM=1288" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="360" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a10" value="_run_enhanced_ocr(prose_img, prose-only prompt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="340" height="45" as="geometry" />
        </mxCell>

        <mxCell id="a11" value="_strip_and_splice_tables(prose, tables)&#10;safety net: regex-strip stray &lt;table&gt;, drop MD pipe tables,&#10;splice geometry-grounded tables back in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="440" y="505" width="340" height="65" as="geometry" />
        </mxCell>

        <mxCell id="a12" value="Detailed per-block geometry pipeline&#10;(see diagram 3: table_extractor)" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="850" y="440" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a13" value="Assemble combined = prose + spliced tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="600" width="340" height="45" as="geometry" />
        </mxCell>

        <mxCell id="a14" value="lang_info[&quot;_rag&quot;] = {&#10;  prose: masked-pass VLM text,&#10;  structured: table_extractor dicts (headers/blocks/k/spans/box),&#10;  page_tables: _harvest(combined, &quot;tatr&quot;)&#10;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="700" width="420" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a15" value="Popped by callers (_stream_pdf_enhanced,&#10;_run_pdf_enhanced, _process_single_image_enhanced)&#10;before sending to frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="290" y="800" width="420" height="55" as="geometry" />
        </mxCell>

